# Google OAuth Client ID (type: Web application).
# Public value, safe to expose in a client-side bundle — access is restricted
# by the "Authorized JavaScript origins" configured on the OAuth client.
VITE_GOOGLE_CLIENT_ID=

# API base URL que la wiki le pasa a las miniapps (HTML embebidos) por
# postMessage, antes del ID token. Cámbialo por ambiente (dev/staging/prod).
# Vacío = no se manda config y la miniapp usa su fallback de build.
VITE_MINIAPP_API_BASE_URL=
